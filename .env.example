# Copy to .env (or export these variables) to change the defaults. Everything runs locally.

# Storage
DATABASE_PATH=./tickets.db
TRAINING_DATA_PATH=./data/sample_tickets.csv
MODEL_PATH=./models/solution_model.joblib
KB_DIR=./data/knowledge_base

# ML: below this probability the model's guess is replaced by "escalate to a specialist"
ML_CONFIDENCE_THRESHOLD=0.20

# Retrieval: auto | sentence-transformers | ollama | tfidf
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_MIN_SCORE=0.10

# Local LLM through Ollama
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# Workflow
AUTO_GENERATE_ON_CREATE=true
SEED_DEFAULT_FIELDS=true
